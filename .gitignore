dist/

# Core Design export artifacts — regenerated by the tool, never shipped.
screenshots/
uploads/
.thumbnail

# Design-system files that never execute at runtime and are regenerable by re-exporting
# from Core Design. Proven render-neutral by scripts/compare-guides.mjs; build.mjs excludes
# them from dist/ regardless. Kept out of git to keep clones small (_ds_bundle.js is ~10MB).
_ds/**/_ds_bundle.js
_ds/**/_ds_manifest.json
_ds/**/_adherence.oxlintrc.json

# Local-only: maps real customer values to fictional ones for import sanitization.
# Never commit — it contains the real values by definition.
sanitize.local.json
# Raw Core Design exports land here before sanitization; never tracked.
_incoming/

# Translation working fragments — regenerate with npm run translate
.translate/
