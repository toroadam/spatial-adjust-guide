node_modules/
dist/

# Core Design export artifacts — regenerated by the tool, never shipped.
screenshots/
uploads/
.thumbnail

# Design-system files that never execute at runtime and are regenerable by re-exporting
# from Core Design. Proven render-neutral by scripts/compare-guides.mjs; build.mjs excludes
# them from dist/ regardless. Kept out of git to keep clones small (_ds_bundle.js is ~10MB).
_ds/**/_ds_bundle.js
_ds/**/_ds_manifest.json
_ds/**/_adherence.oxlintrc.json

# Local-only: maps real customer values to fictional ones for import sanitization.
# Never commit — it contains the real values by definition.
sanitize.local.json
# Raw Core Design exports land here before sanitization; never tracked.
_incoming/

# Translation working fragments — regenerate with npm run translate
.translate/

# Expert review pack (npm run review-pack). Internal: shared through Toro SharePoint/Teams,
# never committed and never published. build.mjs does not copy it into dist/.
review-pack/

# Release media staged for the build (npm run media:fetch) and the test fixture media. Videos are
# GitHub Release assets and never enter git; see README > Video.
.media/
.media-fixture/
# Video pipeline (video/): media never enters git. It belongs under the media root
# (~/Documents/SpatialAdjust_MarCom/, see video/README.md). These globs are the second line of
# defence; npm run video -- hygiene is the check. Do not ignore *.png globally: assets/ and
# _ds/ hold committed PNGs.
video/**/*.mp4
video/**/*.mov
video/**/*.wav
video/**/*.mp3
video/**/*.m4a
video/**/*.aac
video/**/*.flac
video/**/*.webm
video/**/raw/
video/**/_video/
video/**/_audio/
video/**/state.json
# Local-only maps and settings (for example video/capture/overlay.local.json): real values by
# definition, read only by scripts at run time. Never commit.
*.local.json
# Python bytecode from the video pipeline and its tests.
__pycache__/
# Moderated-session raw files (__saExport() events and moderator sheets). Participant data: never
# committed. docs/test-protocol.md > A note on the data; scripts/session-readout.mjs reads them.
_sessions/
