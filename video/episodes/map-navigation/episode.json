    {
      "id": "V3a",
      "chapter": "c3",
      "text": "The button beside the legend toggles between VWC and variance.",
      "claims": [
        "map-navigation/3/2"
      ],
      "previous_text": "Dragging a handle changes the boundary and saves it to your preferences.",
      "next_text": "Variance colors each station by how far it sits from its own target instead of by its raw reading: three bands, centered on target."
    },
    {
      "id": "V3b",
      "chapter": "c3",
      "text": "Variance colors each station by how far it sits from its own target instead of by its raw reading: three bands, centered on target.",
      "claims": [
        "map-navigation/3/3",
        "map-navigation/3/6"
      ],
      "previous_text": "The button beside the legend toggles between VWC and variance.",
      "next_text": "Layers chooses which stations are drawn: all of them, or only the enabled ones."
    },
    {
      "id": "V4a",
      "chapter": "c4",
      "text": "Layers chooses which stations are drawn: all of them, or only the enabled ones.",
      "claims": [
        "map-navigation/4/3",
        "map-navigation/5/3"
      ],
      "previous_text": "Variance colors each station by how far it sits from its own target instead of by its raw reading: three bands, centered on target.",
      "next_text": "Disabled stations are not being adjusted, so hiding them leaves only the stations your push will affect. Layers saves your choice to your user preferences."
    },
    {
      "id": "V4b",
      "chapter": "c4",
      "text": "Disabled stations are not being adjusted, so hiding them leaves only the stations your push will affect. Layers saves your choice to your user preferences.",
