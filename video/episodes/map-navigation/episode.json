  "vo": [
    {
      "id": "V0",
      "text": "Read the stations on the map, move the moisture bands, switch to variance, and filter what the map shows.",
      "claims": [
        "map-navigation/summary/1"
      ],
      "next_text": "The map plots each sprinkler of a station scanned in the past seven days at its own coordinates. A station scanned today is filled with the color of the moisture band its reading falls into, and a station last scanned on an earlier day is drawn clear."
    },
    {
      "id": "V1a",
      "chapter": "c1",
      "text": "The map plots each sprinkler of a station scanned in the past seven days at its own coordinates. A station scanned today is filled with the color of the moisture band its reading falls into, and a station last scanned on an earlier day is drawn clear.",
      "claims": [
        "map-navigation/start/3",
        "map-navigation/1/3",
        "map-navigation/1/4"
      ],
      "previous_text": "Read the stations on the map, move the moisture bands, switch to variance, and filter what the map shows.",
      "next_text": "Four bands by default: 0 to 5, 6 to 19, 20 to 30, and above 30 percent. The colors and boundaries are yours to change."
    },
    {
      "id": "V1b",
      "chapter": "c1",
      "text": "Four bands by default: 0 to 5, 6 to 19, 20 to 30, and above 30 percent. The colors and boundaries are yours to change.",
      "claims": [
        "map-navigation/1/3"
      ],
      "previous_text": "The map plots each sprinkler of a station scanned in the past seven days at its own coordinates. A station scanned today is filled with the color of the moisture band its reading falls into, and a station last scanned on an earlier day is drawn clear.",
      "next_text": "The color bar under the legend has draggable handles. Move one and the map recolors when you let go."
    },
    {
      "id": "V2a",
      "chapter": "c2",
      "text": "The color bar under the legend has draggable handles. Move one and the map recolors when you let go.",
      "claims": [
        "map-navigation/2/2",
