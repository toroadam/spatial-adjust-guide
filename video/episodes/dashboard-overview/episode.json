  "vo": [
    {
      "id": "V0",
      "text": "The whole feature lives on one screen. Here are its four regions.",
      "claims": [
        "dashboard-overview/summary/1",
        "dashboard-overview/tile/2"
      ]
    },
    {
      "id": "V1",
      "chapter": "c1",
      "text": "Start at the toolbar. It shows your site name, the weather strip, and the average, high, and low moisture for the course.",
      "claims": [
        "dashboard-overview/1/1",
        "dashboard-overview/1/3",
        "dashboard-overview/1/5",
        "dashboard-overview/1/7"
      ]
    },
    {
      "id": "V2a",
      "chapter": "c2",
      "text": "On the map, stations scanned today are filled with a color. Stations from an earlier scan are drawn clear.",
      "claims": [
        "dashboard-overview/2/3",
        "dashboard-overview/2/6"
      ]
    },
    {
      "id": "V2b",
      "chapter": "c2",
      "text": "The legend gives four bands, from 0 to 5 percent up to above 30. Each station takes its band's color, so you can see which stations are dry.",
      "claims": [
        "dashboard-overview/2/8",
        "dashboard-overview/2/3"
      ]
    },
    {
      "id": "V2c",
      "chapter": "c2",
      "text": "These bands are only the starting point. The band boundaries are yours to change.",
      "claims": [
        "dashboard-overview/2/8",
        "map-navigation/2/6"
      ]
    },
    {
      "id": "V2d",
      "chapter": "c2",
      "text": "Drag a handle, then let go, and the map recolors.",
      "claims": [
        "map-navigation/2/2",
        "map-navigation/2/3"
      ]
    },
    {
      "id": "V2e",
      "chapter": "c2",
      "text": "This button switches to variance, which shows how far each station is from its target.",
      "claims": [
        "map-navigation/3/2",
        "map-navigation/3/3"
      ]
    },
    {
      "id": "V3a",
      "chapter": "c3",
      "text": "This list picks the areas, holes, or stations the chart plots.",
      "claims": [
        "dashboard-overview/3/2",
        "dashboard-overview/3/3"
      ]
    },
    {
      "id": "V3b",
      "chapter": "c3",
      "text": "The header shows your selection and its average moisture.",
      "claims": [
        "dashboard-overview/3/8",
        "dashboard-overview/3/6"
      ]
    },
    {
      "id": "V4a",
      "chapter": "c4",
      "text": "The table is a drill-down. It starts at the course, with a row for each area.",
      "claims": [
        "dashboard-overview/4/2",
        "dashboard-overview/4/7"
      ]
    },
    {
      "id": "V4b",
      "chapter": "c4",
      "text": "Click an area to see its holes.",
      "claims": [
        "dashboard-overview/4/7",
        "dashboard-overview/4/8"
      ]
    },
    {
      "id": "V4c",
      "chapter": "c4",
      "text": "Click a hole to see its stations.",
      "claims": [
        "dashboard-overview/4/2",
        "dashboard-overview/4/3"
      ]
    },
    {
      "id": "V4d",
      "chapter": "c4",
      "text": "Click a station's row, and the chart header follows.",
      "claims": [
        "dashboard-overview/4/8",
        "dashboard-overview/3/6"
      ]
    },
    {
      "id": "V4d2",
      "chapter": "c4",
      "text": "The check box is separate. It picks stations for a bulk change.",
      "claims": [
        "bulk-adjustments/1/2",
        "bulk-adjustments/summary/1"
      ]
    },
    {
      "id": "V4e",
      "chapter": "c4",
      "text": "Three columns are yours to edit: Target VWC, the percent adjustment, and the Enable switch.",
      "claims": [
        "dashboard-overview/4/4"
      ]
    },
    {
      "id": "V4f",
      "chapter": "c4",
      "text": "You can't edit Current or Suggested adjustment.",
      "claims": [
        "dashboard-overview/4/4"
      ]
    },
    {
      "id": "V4g",
      "chapter": "c4",
      "text": "To go back up, click a name in the trail.",
      "claims": [
        "dashboard-overview/4/5"
      ]
    },
    {
      "id": "V5a",
      "chapter": "c5",
      "text": "Before you leave, read the number on Push Changes. That is how many changes are pending.",
      "claims": [
        "dashboard-overview/5/2",
        "dashboard-overview/5/3"
      ]
    },
    {
      "id": "V5b",
      "chapter": "c5",
      "text": "The green counter beside it shows how many went out today.",
      "claims": [
        "dashboard-overview/5/3"
      ]
    }
  ],
